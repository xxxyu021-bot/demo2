{
    "device": "cuda",

    "dataset_name": "MSRA",

    "model_name": "bert-base-chinese",

    "dropout_rate": 0.3,
    "batch_size": 8,
    "num_epochs": 6,
    "learning_rate": 2e-5,
    "max_seq_len": 128,
    "weight_decay": 0.01,
    "seed": 42,
    "warmup_ratio": 0.1,
    "early_stopping_patience": 3,

    "data": {
        "MSRA": {
            "train_txt_path": "data/MSRA/train_5k.txt",
            "dev_txt_path": "data/MSRA/dev_1k.txt",
            "test_txt_path": "data/MSRA/test_1k.txt"
        },

        "weibo": {
            "train_txt_path": "data/weibo/train.txt",
            "dev_txt_path": "data/weibo/dev.txt",
            "test_txt_path": "data/weibo/test.txt"
        }
    },

    "swanlab": {
        "project": "bert-ner-demo2"
    }
}